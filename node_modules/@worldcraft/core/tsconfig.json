{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@schema": ["../packages/schema/src/index.ts"],
      "@schema/*": ["../packages/schema/src/*"],
      "@core": ["src/index.ts"],
      "@core/*": ["src/*"],
      "@editor": ["../plotailor/src/index.ts"],
      "@editor/*": ["../plotailor/src/*"],
      "@nano": ["../narrative-nano/src/index.ts"],
      "@nano/*": ["../narrative-nano/src/*"]
    }
  },
  "include": ["src/**/*"]
}
