{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@schema": ["stubs/schema/src/index.ts"],
      "@schema/*": ["stubs/schema/src/*"],
      "@core": ["stubs/core/src/index.ts"],
      "@core/*": ["stubs/core/src/*"],
      "@editor": ["src/index.ts"],
      "@editor/*": ["src/*"],
      "@nano": ["stubs/nano/src/index.ts"],
      "@nano/*": ["stubs/nano/src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
