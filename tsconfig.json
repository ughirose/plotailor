{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@schema": ["./node_modules/@worldcraft/schema/src/index.ts", "../packages/schema/src/index.ts"],
      "@schema/*": ["./node_modules/@worldcraft/schema/src/*", "../packages/schema/src/*"],
      "@core": ["./node_modules/@worldcraft/core/src/index.ts", "../worldcraft/src/index.ts"],
      "@core/*": ["./node_modules/@worldcraft/core/src/*", "../worldcraft/src/*"],
      "@editor": ["src/index.ts"],
      "@editor/*": ["src/*"],
      "@nano": ["../narrative-nano/src/index.ts"],
      "@nano/*": ["../narrative-nano/src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
