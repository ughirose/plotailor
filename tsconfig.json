{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@schema": ["src/stubs/schema.ts"],
      "@schema/*": ["src/stubs/*"],
      "@core": ["src/stubs/core.ts"],
      "@core/*": ["src/stubs/*"],
      "@editor": ["src/index.ts"],
      "@editor/*": ["src/*"],
      "@nano": ["src/stubs/nano.ts"],
      "@nano/*": ["src/stubs/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
